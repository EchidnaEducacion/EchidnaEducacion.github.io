---
// Layout Base: <head>, iconos, cabecera, pie y scripts comunes a todas las plantillas
import Iconos from '../components/Iconos.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { Font } from 'astro:assets';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Sección del menú: color de acento y entrada activa */
  section?: string;
  /** Usa el título tal cual, sin añadir « · Echidna Educación» */
  bare?: boolean;
  /** Pide a los buscadores que no la indexen (maquetas) */
  noindex?: boolean;
  /** Imagen al compartir, en vez de la común; `src` relativa a la web o absoluta */
  image?: { src: string; width: number; height: number; alt: string };
  /** Entrada del blog: Open Graph de tipo `article` */
  article?: { published: Date; modified?: Date; author?: string; section?: string; tags?: string[] };
}
const { title, description = '', section, bare = false, noindex = false, image, article } = Astro.props;
const fullTitle = bare ? title : `${title} · Echidna Educación`;
// Para compartir en redes (Open Graph): direcciones absolutas, con el dominio de `site`
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenRedes = image
  ? { ...image, src: new URL(image.src, Astro.site).href }
  : {
      src: new URL(url('imagen-redes.png'), Astro.site).href, width: 1200, height: 630,
      alt: 'Logo de Echidna: un equidna naranja con el nombre «Echidna»',
    };
// Código del sitio en GoatCounter (estadísticas de visitas); sin él, no se carga su script
const goatcounter = import.meta.env.PUBLIC_GOATCOUNTER_CODE;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonica}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:type" content={article ? 'article' : 'website'}>
<meta property="og:site_name" content="Echidna Educación">
<meta property="og:locale" content="es_ES">
<meta property="og:url" content={canonica}>
<meta property="og:title" content={fullTitle}>
{description && <meta property="og:description" content={description}>}
<!-- Imagen al compartir: la de la página o la común (1200 × 630), que genera `bun run imagen-redes` a partir del logo -->
<meta property="og:image" content={imagenRedes.src}>
<meta property="og:image:width" content={imagenRedes.width}>
<meta property="og:image:height" content={imagenRedes.height}>
<meta property="og:image:alt" content={imagenRedes.alt}>
{article && <meta property="article:published_time" content={article.published.toISOString()}>}
{article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()}>}
{article?.author && <meta property="article:author" content={new URL(article.author, Astro.site).href}>}
{article?.section && <meta property="article:section" content={article.section}>}
{article?.tags?.map((t) => <meta property="article:tag" content={t}>)}
<meta name="twitter:card" content="summary_large_image">
{section && <meta data-pagefind-meta="seccion[content]" content={section}>}
<link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
<link rel="apple-touch-icon" href={url("apple-touch-icon.png")}>
<link rel="alternate" type="application/rss+xml" title="Blog de Echidna Educación" href={url("rss.xml")}>
<script is:inline>try{var t=localStorage.getItem('echidna-theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<!-- Tipografías servidas desde la propia web (ver «tipografias» en astro.config.mjs) -->
<Font cssVariable="--font-body" preload={[{ weight: '400', style: 'normal' }]} />
<Font cssVariable="--font-head" preload />
<Font cssVariable="--font-mono" />
<Font cssVariable="--font-brand" />
<link rel="stylesheet" href={url("assets/css/echidna.css")}>
{goatcounter && <script is:inline async data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
</head>
<body data-section={section}>
<div class="page">
<Iconos />
<Cabecera section={section} />
<slot />
<Pie />
<script is:inline src={url("assets/js/echidna.js")}></script>
</div>
</body>
</html>
